APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inbils
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Workers: `queue:work --queue=default,whatsapp --tries=3 --timeout=90`, and for the platform panel's long jobs (sample
# data, tenant exports) a second one on its own connection: `queue:work platform --queue=platform --tries=1 --timeout=3600`.
# Its retry_after (3660) is fixed in config/queue.php. See docs/operations/platform-queue.md.

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Midtrans. Sandbox keys belong on dev/staging hosts only: with APP_ENV=production and
# MIDTRANS_IS_PRODUCTION=false the gateway stays off unless the owner opts in below.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOW_SANDBOX_IN_PRODUCTION=false
# Optional HTTPS webhook URL sent as X-Override-Notification on every Snap order (no dashboard edit needed).
MIDTRANS_NOTIFICATION_URL=

# WhatsApp Cloud API (Meta). One install-wide sender; the feature stays off while the token or the phone
# number id is empty. Real values live only in the host .env. Workers must run `queue:work --queue=default,whatsapp`.
# Webhook URL to register in the Meta app: <APP_URL>/webhooks/whatsapp (verify token below). Graph version defaults to v25.0.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=

# Push notifications to the mobile apps (Firebase Cloud Messaging, HTTP v1). Path of the Admin SDK service-account JSON,
# absolute or relative to the project root, kept outside git (Sail: copy it to storage/app/private/, which git ignores).
# Empty = push is off. The queue worker sends the pushes. See docs/operations/push-notifications.md.
FIREBASE_CREDENTIALS=

# FreeRADIUS provisioning. Off by default: with the switch off nothing is read from or written to the RADIUS database.
# Separate database with the stock FreeRADIUS 3.2 schema; the driver defaults to mysql.
RADIUS_ENABLED=false
RADIUS_DB_HOST=
RADIUS_DB_PORT=
RADIUS_DB_DATABASE=
RADIUS_DB_USERNAME=
RADIUS_DB_PASSWORD=

# Laravel Sail (local development): ./vendor/bin/sail up -d
# APP_PORT is intentionally unset: compose.yaml (production build) also reads it; Sail defaults to 80.
SAIL_FILES=compose.sail.yaml
WWWUSER=1000
WWWGROUP=1000
VITE_PORT=5173
