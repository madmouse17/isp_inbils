APP_NAME=INBILS
APP_ENV=production
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inbils
DB_USERNAME=inbils
DB_PASSWORD=inbils_local_change_me
DOCKER_DB_DATABASE=inbils
DOCKER_DB_USERNAME=inbils
DOCKER_DB_PASSWORD=inbils_local_change_me
DOCKER_DB_ROOT_PASSWORD=inbils_root_local_change_me
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Midtrans. Sandbox keys belong on dev/staging hosts only: with APP_ENV=production and
# MIDTRANS_IS_PRODUCTION=false the gateway stays off unless the owner opts in below.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOW_SANDBOX_IN_PRODUCTION=false

# true only for local images (installs composer dev packages)
INSTALL_DEV=false
