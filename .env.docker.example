APP_NAME=Inbils
APP_ENV=production
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
# Reverse proxies or load balancers in front of the stack (a TLS terminator, say): comma-separated addresses (CIDR ranges
# work), or * only when the proxy is the single way in. Their X-Forwarded-* headers then name the client; empty trusts
# nobody, so everyone is seen at the proxy's address (config/security.php).
TRUSTED_PROXIES=

APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# stderr is what `docker compose logs` shows, one JSON object per line; daily also keeps LOG_DAILY_DAYS files in
# storage/logs (the app_storage volume). The Docker side is capped in compose.yaml.
LOG_STACK=stderr,daily
LOG_DAILY_DAYS=14
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inbils
DB_USERNAME=inbils
DB_PASSWORD=inbils_local_change_me
DOCKER_DB_DATABASE=inbils
DOCKER_DB_USERNAME=inbils
DOCKER_DB_PASSWORD=inbils_local_change_me
DOCKER_DB_ROOT_PASSWORD=inbils_root_local_change_me
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# The `queue` service runs the default and whatsapp queues; the `platform-queue` service runs the platform panel's long
# jobs (sample data, tenant exports) on their own connection, one try and one hour. See docs/operations/platform-queue.md.
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@inbils.local
MAIL_FROM_NAME="${APP_NAME}"


# Midtrans, WhatsApp and RADIUS below are IMPORT SOURCES ONLY. Every company keeps its own accounts in
# Pengaturan → Integrasi; after `php artisan migrate`, run once per company:
#   php artisan inbils:integrations:import-env --company=<code>
# Until then (or until an admin enters them) Midtrans and WhatsApp are OFF for that company, and RADIUS stays off.
# The app never reads these keys at runtime, except WHATSAPP_GRAPH_VERSION. Mail is not imported: MAIL_* above stays the platform sender.
#
# Midtrans. Sandbox keys belong on dev/staging hosts only: on a production host (APP_ENV=production) a sandbox row
# (MIDTRANS_IS_PRODUCTION=false) stays off unless MIDTRANS_ALLOW_SANDBOX_IN_PRODUCTION=true is imported on purpose.
# MIDTRANS_MERCHANT_ID and MIDTRANS_CLIENT_KEY are not imported: nothing reads them.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOW_SANDBOX_IN_PRODUCTION=false

# WhatsApp Cloud API (Meta). Import source for phone_number_id, access token, app secret and verify token.
# Workers must run `queue:work --queue=default,whatsapp`. The webhook URL for the Meta app stays one shared
# <APP_URL>/webhooks/whatsapp for every company. WHATSAPP_GRAPH_VERSION is read at runtime (default v25.0).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=

# Push notifications to the mobile apps (Firebase Cloud Messaging). HOST path of the Admin SDK service-account JSON, kept
# outside git. compose.yaml mounts it read-only in every app container and sets FIREBASE_CREDENTIALS for them; leave it
# empty and push stays off. See docs/operations/push-notifications.md.
FIREBASE_CREDENTIALS_FILE=

# FreeRADIUS import source: with RADIUS_ENABLED=true the import copies this connection (separate database with the
# stock FreeRADIUS 3.2 schema) into the company's RADIUS integration. The driver defaults to mysql.
RADIUS_ENABLED=false
RADIUS_DB_HOST=
RADIUS_DB_PORT=
RADIUS_DB_DATABASE=
RADIUS_DB_USERNAME=
RADIUS_DB_PASSWORD=

# true only for local images (installs composer dev packages)
INSTALL_DEV=false
