APP_NAME=INBILS
APP_ENV=production
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080

APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inbils
DB_USERNAME=inbils
DB_PASSWORD=inbils_local_change_me
DOCKER_DB_DATABASE=inbils
DOCKER_DB_USERNAME=inbils
DOCKER_DB_PASSWORD=inbils_local_change_me
DOCKER_DB_ROOT_PASSWORD=inbils_root_local_change_me
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# The `queue` service runs the default and whatsapp queues; the `platform-queue` service runs the platform panel's long
# jobs (sample data, tenant exports) on their own connection, one try and one hour. See docs/operations/platform-queue.md.
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"


# Midtrans. Sandbox keys belong on dev/staging hosts only: with APP_ENV=production and
# MIDTRANS_IS_PRODUCTION=false the gateway stays off unless the owner opts in below.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOW_SANDBOX_IN_PRODUCTION=false
# Optional HTTPS webhook URL sent as X-Override-Notification on every Snap order (no dashboard edit needed).
MIDTRANS_NOTIFICATION_URL=

# WhatsApp Cloud API (Meta). One install-wide sender; the feature stays off while the token or the phone
# number id is empty. Real values live only in the host .env. Workers must run `queue:work --queue=default,whatsapp`.
# Webhook URL to register in the Meta app: <APP_URL>/webhooks/whatsapp (verify token below). Graph version defaults to v25.0.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=

# Push notifications to the mobile apps (Firebase Cloud Messaging). HOST path of the Admin SDK service-account JSON, kept
# outside git. compose.yaml mounts it read-only in every app container and sets FIREBASE_CREDENTIALS for them; leave it
# empty and push stays off. See docs/operations/push-notifications.md.
FIREBASE_CREDENTIALS_FILE=

# FreeRADIUS provisioning. Off by default: with the switch off nothing is read from or written to the RADIUS database.
# Separate database with the stock FreeRADIUS 3.2 schema; the driver defaults to mysql.
RADIUS_ENABLED=false
RADIUS_DB_HOST=
RADIUS_DB_PORT=
RADIUS_DB_DATABASE=
RADIUS_DB_USERNAME=
RADIUS_DB_PASSWORD=

# true only for local images (installs composer dev packages)
INSTALL_DEV=false
