{
    auto_https off
    frankenphp
}

{$SERVER_NAME:localhost} {
    root * /app/public
    encode zstd br gzip

    php_server

    @static {
        file
        path *.css *.js *.mjs *.map *.png *.jpg *.jpeg *.gif *.svg *.webp *.ico *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}
