APP_ENV=e2e
APP_DEBUG=true
APP_KEY=
APP_URL=http://127.0.0.1:8010
BOOST_BROWSER_LOGS_WATCHER=false
# Generate a local key after copying: php artisan key:generate --env=e2e

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=inbils_test
DB_USERNAME=inbils
DB_PASSWORD=

# scripts/e2e-server-env.mjs forces CACHE_STORE=database for the served app and for setup.php (the `cache` table of the
# migrations): `artisan serve` forgets PHP process state after every request, so `array` would leave every cache-backed
# guard (duplicate submit, throttles) inert. This value only serves a command run by hand.
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
MAIL_MAILER=array

# Push counts as on, with a file that does not exist: tests/e2e/tenant-integrations.spec.ts gets 202 from the push-test API,
# and the push job fails at once on the missing file, so nothing ever calls Google.
FIREBASE_CREDENTIALS=storage/app/e2e-firebase-missing.json

# Fake Midtrans sandbox values; tests/e2e/midtrans-payment.spec.ts serves a mock Snap/Status API on MIDTRANS_BASE_URL.
MIDTRANS_MERCHANT_ID=G000000000
MIDTRANS_CLIENT_KEY=SB-Mid-client-E2E-FAKE
MIDTRANS_SERVER_KEY=SB-Mid-server-E2E-FAKE-KEY
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BASE_URL=http://127.0.0.1:18911
