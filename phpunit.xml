<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory suffix="Test.php">Modules</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="LOG_CHANNEL" value="stderr"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="mysql" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="inbils_test" force="true"/>
        <env name="DB_USERNAME" value="inbils" force="true"/>
        <env name="DB_PASSWORD" value="inbils_local_change_me" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            PHPUnit <env> values (even force="true") can be shadowed by a
            pre-existing $_SERVER entry, while Laravel's Env repository reads
            $_SERVER first. Pin the decisive variables through <server> so an
            ambient shell export (e.g. DB_DATABASE=inbils) can never redirect
            the regression target away from the isolated test database.
        -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_HOST" value="mysql" force="true"/>
        <server name="DB_PORT" value="3306" force="true"/>
        <server name="DB_DATABASE" value="inbils_test" force="true"/>
        <server name="DB_USERNAME" value="inbils" force="true"/>
        <server name="DB_PASSWORD" value="inbils_local_change_me" force="true"/>
        <server name="DB_URL" value="" force="true"/>
    </php>
</phpunit>
